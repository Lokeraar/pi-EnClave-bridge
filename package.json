    "openrouter-compatible",
    "model-catalog",
    "model-sync",
    "ai-model",
    "llm-router"
  ],
  "author": "Lokeraar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lokeraar/pi-EnClave-bridge.git"
  },
