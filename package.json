  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lokeraar/pi-EnClave-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Lokeraar/pi-EnClave-bridge/issues"
  },
  "homepage": "https://pi.dev/packages/@lokeraar/pi-enclave-bridge",
